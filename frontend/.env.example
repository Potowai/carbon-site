# Frontend Environment Variables Example
# Note: Supabase config is loaded from the backend at runtime via /api/config
# This file is for documentation only and is NOT used by the build process

# Local development - Backend API endpoint
NG_APP_API_URL=http://localhost:3000/api
NG_APP_CONFIG_URL=http://localhost:3000/api/config

# Production - Deployed on Render
# NG_APP_API_URL=https://carbon-site-back.onrender.com/api
# NG_APP_CONFIG_URL=https://carbon-site-back.onrender.com/api/config
